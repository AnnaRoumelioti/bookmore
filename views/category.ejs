<%- include("partials/header") %>

<%- include("partials/navigation") %>

<%- include("partials/sidebar") %>


  <main class="container mt-4">

    <h2 id="category-title"><%= category %></h2>

    <div id="books-container" class="row g-4"></div>

    </div>

</main>

<script src="/js/renderBooks.js"></script>


<script>

const category = <%- JSON.stringify(category) %>;

fetch(`/api/categories/${encodeURIComponent(category)}`)
    .then(response => response.json())
    .then(books => {

        const container = document.getElementById("books-container");

    renderBooks(container, books);

    })
    .catch(console.error);

</script>


<%- include("partials/footer") %>