<%- include("partials/header") %>

    <%- include("partials/navigation") %>

        <%- include("partials/sidebar") %>

            <main class="container mt-4">

                <div id="publisher-container"></div>
                  </div>

            </main>

            <script src="/js/renderBooks.js"></script>

            <script>

                const publisherSlug = "<%= publisherSlug %>";

                fetch(`/api/publishers/${publisherSlug}`)
                    .then(response => response.json())
                    .then(data => {

                        console.log(data);

                        const container = document.getElementById("publisher-container");

                        container.innerHTML = `
                       <div class="page-header">

                        <h2>${data.publisher.name}</h2>

                            <p>
                             ${data.publisher.country ?? ""}
                            </p>

                        <a href="${data.publisher.website_url ?? "#"}"
                            target="_blank"
                            class="links">

                           ${data.publisher.website_url ?? ""} </a>

                          </div>

                        <div class="separator"></div>

                        <h3 class="books-title">
                         Books published by ${data.publisher.name}
                                          </h3>

                          <div id="books-container" class="row g-4 mt-1"></div>
                               `;

                        const booksContainer =
                            document.getElementById("books-container");

                          renderBooks(booksContainer, data.books);

                             })
                             .catch(console.error);

             </script>


                  <%- include("partials/footer") %>