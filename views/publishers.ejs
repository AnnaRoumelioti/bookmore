<%- include("partials/header") %>

<%- include("partials/navigation") %>

<%- include("partials/sidebar") %>

<main>

    <h2>Publishers</h2>

    <div id="publishers-container"></div>

</main>

</div>

<script>

fetch("/api/publishers")
    .then(res => res.json())
    .then(publishers => {
        const container =
            document.getElementById("publishers-container");
        container.innerHTML = "";

        let currentLetter = "";
        publishers.forEach(pub => {
            const firstLetter =
                pub.name.charAt(0).toUpperCase();
            if (firstLetter !== currentLetter) {
                currentLetter = firstLetter;

                container.innerHTML += `
                    <h3 class="alllist-letter">
                        ${currentLetter}
                    </h3>
                    <div id="group-${currentLetter}"></div>
                `;
            }

            document.getElementById(`group-${currentLetter}`)
                .innerHTML += `
                    <p>
                        <a href="/publishers/${pub.slug}"
                           class="alllist-link">
                            ${pub.name}
                        </a>
                    </p>
                `;
        });
    })
    .catch(error => console.error(error));

</script>


