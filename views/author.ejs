<%- include("partials/header") %>

<%- include("partials/navigation") %>

    <%- include("partials/sidebar") %>

<main class="container mt-4">

    <div>
        <h2 id="author-name"></h2>
        <p id="author-biography"></p>
    </div>

    <div class="separator"></div>

    <h2 class="text-center mb-4">Books</h2>

    <div id="books-container" class="row g-4"> </div>

</main>

</div>

<%- include("partials/footer") %>

<script>

const slug = window.location.pathname.split("/").pop();

fetch(`/api/authors/${slug}`)
    .then(response => response.json())
    .then(author => {

        document.getElementById("author-name").textContent = author.full_name;
        document.getElementById("author-biography").textContent = author.biography;

        return fetch(`/api/authors/${slug}/books`);

    })
    .then(response => response.json())
    .then(books => {

        const container = document.getElementById("books-container");

        renderBooks(container, books);

    })
    .catch(console.error);

</script>