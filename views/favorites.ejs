  <main class="container mt-4">

    <h2>Favorites</h2>

    <div id="books-container" class="row g-4" data-favorites-list="true"></div>

    </div>
    
</main>


<script>

fetch("/api/favorites")
    .then(response => response.json())
    .then(books => {

        const container = document.getElementById("books-container");

    renderBooks(container, books);

    })
    .catch(console.error);

    showFavoriteMessage(
    "Book is removed from Favorites",
    button
);

</script>


