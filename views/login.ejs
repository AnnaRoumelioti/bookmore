<%- include("partials/header") %>

  <%- include("partials/navigation") %>

    <%- include("partials/sidebar") %>

      <main class="container mt-4">

        <h2>Login</h2>
     <div class="auth-container">
        <p id="login-error" class="field-error" style="display: none;">Invalid email or password</p>

        <form method="POST" action="/auth/login" class="auth-form">

          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
          <p id="login-email-error" class="field-error"></p>

          <label for="password">Password</label>
          <input type="password" id="password" name="password" required>
          <p id="login-email-error" class="field-error"></p>

          <button type="submit">Login</button>

        </form>

        <p>No account yet? <a href="/signup" class="links">Sign up</a></p>
        </div>
        </div>

      </main>

      <script>

        const loginForm =
          document.querySelector(".auth-form");

        const loginEmail =
          document.getElementById("email");

        const loginPassword =
          document.getElementById("password");


        const loginEmailError =
          document.getElementById("login-email-error");

        const loginPasswordError =
          document.getElementById("login-password-error");


        const emailRegex =
          /^[^\s@]+@[^\s@]+\.[^\s@]+$/;


        function validateLoginEmail() {

          const value =
            loginEmail.value.trim();

          if (value === "") {

            loginEmailError.textContent =
              "Email is required.";

            return false;
          }

          if (!emailRegex.test(value)) {

            loginEmailError.textContent =
              "Please enter a valid email address.";

            return false;
          }

          loginEmailError.textContent = "";

          return true;
        }


        function validateLoginPassword() {

          const value =
            loginPassword.value;

          if (value === "") {

            loginPasswordError.textContent =
              "Password is required.";

            return false;
          }

          loginPasswordError.textContent = "";

          return true;
        }

        loginEmail.addEventListener(
          "input",
          validateLoginEmail
        );

        loginPassword.addEventListener(
          "input",
          validateLoginPassword
        );

        loginEmail.addEventListener("input", function () {

    document.getElementById("login-error")
        .style.display = "none";

});

loginPassword.addEventListener("input", function () {

    document.getElementById("login-error")
        .style.display = "none";

});

        loginForm.addEventListener(
          "submit",
          function (event) {

            const validEmail =
              validateLoginEmail();

            const validPassword =
              validateLoginPassword();

            if (!validEmail || !validPassword) {

              event.preventDefault();

            }

          }
        );

        if (window.location.search.includes("error=1")) {

          document.getElementById("login-error")
            .style.display = "block";

          window.history.replaceState(
            {},
            document.title,
            window.location.pathname
          );

        }

      </script>

      <%- include("partials/footer") %>