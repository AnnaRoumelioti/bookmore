<%- include("partials/header") %>

  <%- include("partials/navigation") %>

    <%- include("partials/sidebar") %>


      <main>
        <section>

          <div id="carouselExampleCaptions" class="carousel slide my-carousel">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active"
                aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1"
                aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2"
                aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <img src="Images/shops/free_delivery.png" class="d-block w-100" alt="...">
                <div class="carousel-caption">
                  <p><a href="/pages/promotions.html">Learn more <img src="svg/arrow-right.svg" alt=""></a></p>
                </div>
              </div>
              <div class="carousel-item">
                <img src="Images/shops/birthday_discount.png" class="d-block w-100" alt="...">
                <div class="carousel-caption">
                  <p><a href="/pages/promotions.html">Learn more <img src="svg/arrow-right.svg" alt=""></a></p>
                </div>
              </div>
              <div class="carousel-item">
                <img src="Images/shops/fortune_wheel.png" class="d-block w-100" alt="...">
                <div class="carousel-caption">
                  <p><a href="/pages/promotions.html">Learn more <img src="svg/arrow-right.svg" alt=""></a></p>
                </div>
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions"
              data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions"
              data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>



          <section class="homepage-books-section">

            <div class="section-header">
              <h2>New Books</h2>
            </div>

            <div class="book-carousel">

              <button class="carousel-button carousel-prev" type="button">
                ‹
              </button>

              <div class="book-carousel-track" id="new-books-carousel">
              </div>

              <button class="carousel-button carousel-next" type="button">
                ›
              </button>
            </div>
            <a href="/new-items" class="links">
              View all
            </a>

          </section>

          <section class="homepage-books-section">

            <div class="section-header">
              <h2>Recommended</h2>
            </div>

            <div class="book-carousel">

              <button class="carousel-button carousel-prev" type="button">
                ‹
              </button>

              <div class="book-carousel-track" id="recommended-books-carousel">
              </div>

              <button class="carousel-button carousel-next" type="button">
                ›
              </button>
            </div>
            <a href="/recommended" class="links">
              View all
            </a>

          </section>
      </main>
      </div>

      <script src="/js/renderBookCarousel.js"></script>

      <script>

        fetch("/api/books/latest")

          .then(response => response.json())

          .then(books => {

            const container =
              document.getElementById("new-books-carousel");

            renderBookCarousel(container, books);

          })

          .catch(error => {

            console.error(
              "Error loading new books:",
              error
            );

          });

      </script>

      <%- include("partials/footer") %>